FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [velocity];

internalField   uniform (0 0 0);

boundaryField
{
    inlet_window1
    {
        type            fixedValue;
        value           uniform (1.5 0.1 0);
    }

    inlet_window2
    {
        type            fixedValue;
        value           uniform (1.2 -0.1 0);
    }

    outlet_window1
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    outlet_window2
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    floor
    {
        type            noSlip;
    }

    ceiling
    {
        type            noSlip;
    }

    walls
    {
        type            noSlip;
    }
}

